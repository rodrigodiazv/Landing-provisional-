# Copy the variable names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Admin panel login (server-side check in /api/admin-login)
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=

# Beta sign-up form forwarding (/api/webhook → Make.com)
MAKE_WEBHOOK_URL=
# Shared secret sent as the X-FlowSuite-Secret header; verify it in the Make scenario
MAKE_WEBHOOK_SECRET=
